--- !u!114 &1662126093
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1662126090}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 2dad629c507d1d948ab1afab32c6f011, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  CharacterName: "\u041C\u044D\u0440"
  Avatar: {fileID: 7266584998529060584, guid: 4f863ebf6d929464d9482d32d6a65a10, type: 3}
  DialogueBoxHandler: {fileID: 115809162}
  AnswerGridControl: {fileID: 1049781182}
  dialogues:
  - State: Initial
    DialogueLines:
    - Id: 0
      Name: "\u041C\u044D\u0440"
      Avatar: {fileID: 7266584998529060584, guid: 4f863ebf6d929464d9482d32d6a65a10, type: 3}
      Line: "\u0414\u0435\u0442\u0435\u043A\u0442\u0438\u0432! \u041E\u043D\u0438
        \u0438\u0441\u0447\u0435\u0437\u043B\u0438! \u0418\u0441\u0447\u0435\u0437\u043B\u0438!
        \u041A\u0430\u043A \u0434\u043E\u043C\u0438\u043A \u042D\u043B\u043B\u0438
        \u0432 \u0431\u0443\u0440\u044E!"
      Answers: []
    - Id: 1
      Name: "\u0414\u0438\u0446"
      Avatar: {fileID: 4877971009708017315, guid: c92ba37479e83f84685ed1b0d7246f3b, type: 3}
      Line: "\u0412\u0430\u043C \u043F\u0440\u0438\u0434\u0435\u0442\u0441\u044F
        \u0431\u044B\u0442\u044C \u043D\u0435\u043C\u043D\u043E\u0433\u043E \u0431\u043E\u043B\u0435\u0435
        \u043A\u043E\u043D\u043A\u0440\u0435\u0442\u043D\u044B\u043C, \u0412\u0430\u0448\u0430
        \u0447\u0435\u0441\u0442\u044C. \u041B\u044E\u0434\u0438 \u043F\u043E\u0441\u0442\u043E\u044F\u043D\u043D\u043E
        \u0442\u0435\u0440\u044F\u044E\u0442 \u0432\u0435\u0449\u0438 \u2014 \u043A\u043B\u044E\u0447\u0438,
        \u043A\u043E\u0448\u0435\u043B\u044C\u043A\u0438, \u0434\u043E\u0441\u0442\u043E\u0438\u043D\u0441\u0442\u0432\u043E..."
      Answers: []
    - Id: 2
      Name: "\u041C\u044D\u0440"
      Avatar: {fileID: 7266584998529060584, guid: 4f863ebf6d929464d9482d32d6a65a10, type: 3}
      Line: "\u041C\u043E\u0438 \u0443\u0441\u044B, \u0414\u0438\u0442\u0446! \u041C\u043E\u0438
        \u043F\u0440\u0435\u043A\u0440\u0430\u0441\u043D\u044B\u0435, \u0440\u043E\u0441\u043A\u043E\u0448\u043D\u044B\u0435,
        \u043F\u043E\u0431\u0435\u0434\u043E\u043D\u043E\u0441\u043D\u044B\u0435
        \u0443\u0441\u044B! \u041A\u0442\u043E-\u0442\u043E \u0443\u043A\u0440\u0430\u043B
        \u0438\u0445 \u0441\u0440\u0435\u0434\u0438 \u043D\u043E\u0447\u0438!"
      Answers: []
    - Id: 3
      Name: 
      Avatar: {fileID: 0}
      Line: 
      Answers:
      - AnswerContent: "\u0412\u044B \u043D\u0435\u0434\u0430\u0432\u043D\u043E \u043D\u0435
          \u043F\u043E\u0441\u0435\u0449\u0430\u043B\u0438 \u043F\u0430\u0440\u0438\u043A\u043C\u0430\u0445\u0435\u0440\u0430?"
        OutputState: Braber
        character: {fileID: 1662126093}
      - AnswerContent: "\u041A\u0442\u043E \u0431\u044B \u043C\u043E\u0433 \u0443\u0440\u043A\u0430\u0441\u0442\u044C
          \u0412\u0430\u0448\u0438 \u0443\u0441\u044B?"
        OutputState: Enemies
        character: {fileID: 1662126093}
      - AnswerContent: "\u042F \u043D\u0430\u0447\u043D\u0443 \u0440\u0430\u0441\u0441\u043B\u0435\u0434\u043E\u0432\u0430\u043D\u0438\u0435,
          \u0441\u044D\u0440."
        OutputState: End
        character: {fileID: 1662126093}
  - State: Braber
    DialogueLines:
    - Id: 0
      Name: "\u041C\u044D\u0440"
      Avatar: {fileID: 7266584998529060584, guid: 4f863ebf6d929464d9482d32d6a65a10, type: 3}
      Line: "\u042D\u0442\u043E \u043D\u0435 \u0448\u0443\u0442\u043A\u0430, \u0434\u0435\u0442\u0435\u043A\u0442\u0438\u0432!
        \u0411\u0435\u0437 \u0443\u0441\u043E\u0432 \u044F \u043F\u0440\u043E\u0441\u0442\u043E...
        \u043F\u0430\u0440\u0435\u043D\u044C \u0441 \u043D\u0435\u043E\u0431\u044B\u0447\u043D\u043E
        \u043F\u043E\u0442\u043D\u043E\u0439 \u0432\u0435\u0440\u0445\u043D\u0435\u0439
        \u0433\u0443\u0431\u043E\u0439! \u041C\u043E\u0439 \u0440\u0435\u0439\u0442\u0438\u043D\u0433
        \u043E\u0434\u043E\u0431\u0440\u0435\u043D\u0438\u044F \u0441\u0442\u0440\u0435\u043C\u0438\u0442\u0435\u043B\u044C\u043D\u043E
        \u043F\u0430\u0434\u0430\u0435\u0442!"
      Answers: []
    - Id: 1
      Name: 
      Avatar: {fileID: 0}
      Line: 
      Answers:
      - AnswerContent: "\u0412\u044B \u043D\u0435\u0434\u0430\u0432\u043D\u043E \u043D\u0435
          \u043F\u043E\u0441\u0435\u0449\u0430\u043B\u0438 \u043F\u0430\u0440\u0438\u043A\u043C\u0430\u0445\u0435\u0440\u0430?"
        OutputState: Braber
        character: {fileID: 1662126093}
      - AnswerContent: "\u041A\u0442\u043E \u0431\u044B \u043C\u043E\u0433 \u0443\u043A\u0440\u0430\u0441\u0442\u044C
          \u0412\u0430\u0448\u0438 \u0443\u0441\u044B?"
        OutputState: Enemies
        character: {fileID: 1662126093}
      - AnswerContent: "\u042F \u043D\u0430\u0447\u043D\u0443 \u0440\u0430\u0441\u0441\u043B\u0435\u0434\u043E\u0432\u0430\u043D\u0438\u0435,
          \u0441\u044D\u0440."
        OutputState: End
        character: {fileID: 1662126093}
  - State: End
    DialogueLines:
    - Id: 0
      Name: "\u041C\u044D\u0440"
      Avatar: {fileID: 7266584998529060584, guid: 4f863ebf6d929464d9482d32d6a65a10, type: 3}
      Line: "\u0421\u043F\u0430\u0441\u0438\u0431\u043E, \u0414\u0435\u0442\u0435\u043A\u0442\u0438\u0432."
      Answers: []
  - State: Return
    DialogueLines:
    - Id: 0
      Name: "\u041C\u044D\u0440"
      Avatar: {fileID: 7266584998529060584, guid: 4f863ebf6d929464d9482d32d6a65a10, type: 3}
      Line: "\u0415\u0441\u0442\u044C \u0447\u0442\u043E-\u0442\u043E \u043D\u043E\u0432\u043E\u0435
        \u043F\u043E \u043F\u043E\u043E\u0432\u043E\u0434\u0443 \u0443\u0441\u043E\u0432?"
      Answers: []
    - Id: 1
      Name: 
      Avatar: {fileID: 0}
      Line: 
      Answers:
      - AnswerContent: Did you visit a braber recently?
        OutputState: Braber
        character: {fileID: 1662126093}
      - AnswerContent: How would be likely to steal you mustache?
        OutputState: Enemies
        character: {fileID: 1662126093}
      - AnswerContent: I will start investigation, sir.
        OutputState: End
        character: {fileID: 1662126093}
  - State: Enemies
    DialogueLines:
    - Id: 0
      Name: "\u041C\u044D\u0440"
      Avatar: {fileID: 7266584998529060584, guid: 4f863ebf6d929464d9482d32d6a65a10, type: 3}
      Line: "\u041E\u0434\u043D\u0430\u0436\u0434\u044B \u043D\u0430 \u043C\u0435\u043D\u044F
        \u043D\u0430\u043F\u0430\u043B \u0435\u043D\u043E\u0442!"
      Answers:
      - AnswerContent: Did you visit a braber recently?
        OutputState: Braber
        character: {fileID: 1662126093}
      - AnswerContent: How would be likely to steal you mustache?
        OutputState: Enemies
        character: {fileID: 1662126093}
      - AnswerContent: I will start investigation, sir.
        OutputState: End
        character: {fileID: 1662126093}
    - Id: 1
      Name: "\u0414\u0438\u0446"
      Avatar: {fileID: 4877971009708017315, guid: c92ba37479e83f84685ed1b0d7246f3b, type: 3}
      Line: "\u0410 \u0447\u0442\u043E \u043F\u043E \u043F\u043E\u0432\u043E\u0434\u0443
        \u0431\u043E\u043B\u0435\u0435 \u0440\u0435\u0430\u043B\u044C\u043D\u044B\u0445
        \u043F\u0440\u043E\u0442\u0438\u0432\u043D\u0438\u043A\u043E\u0432?"
      Answers: []
    - Id: 2
      Name: "\u041C\u044D\u0440"
      Avatar: {fileID: 7266584998529060584, guid: 4f863ebf6d929464d9482d32d6a65a10, type: 3}
      Line: "\u041E\u0434\u0438\u043D \u0438\u0437 \u043F\u0430\u0440\u043A\u0438\u043C\u0430\u0445\u0435\u0440\u043E\u0432
        \u043C\u043E\u0435\u0433\u043E \u0441\u043E\u043F\u0435\u0440\u043D\u0438\u043A\u0430
        \u043D\u0430 \u0432\u044B\u0431\u043E\u0440\u0430\u0445, \u043F\u0440\u0435\u043D\u0438\u043F\u0440\u044F\u0442\u043D\u044B\u0439
        \u0442\u0438\u043F, \u043B\u044B\u0441\u044B\u0439"
      Answers: []
    - Id: 3
      Name: "\u041C\u044D\u0440"
      Avatar: {fileID: 7266584998529060584, guid: 4f863ebf6d929464d9482d32d6a65a10, type: 3}
      Line: "\u041E\u043D \u043F\u0440\u043E\u0438\u0433\u0440\u0430\u043B \u043C\u043D\u0435
        \u043D\u0430 \u0441\u043E\u0440\u0435\u0432\u043D\u043E\u0432\u0430\u043D\u0438\u044F\u0445
        \u0437\u0430 \u043B\u0443\u0447\u0448\u0438\u0435 \u0443\u0441\u044B \u0432
        \u043F\u0440\u043E\u0448\u043B\u043E\u043C \u0433\u043E\u0434\u0443."
      Answers: []
    - Id: 4
      Name: 
      Avatar: {fileID: 0}
      Line: 
      Answers:
      - AnswerContent: "\u0412\u044B \u043D\u0435\u0434\u0430\u0432\u043D\u043E \u043D\u0435
          \u043F\u043E\u0441\u0435\u0449\u0430\u043B\u0438 \u043F\u0430\u0440\u0438\u043A\u043C\u0430\u0445\u0435\u0440\u0430?"
        OutputState: Braber
        character: {fileID: 1662126093}
      - AnswerContent: "\u041A\u0442\u043E \u0431\u044B \u043C\u043E\u0433 \u0443\u043A\u0440\u0430\u0441\u0442\u044C
          \u0412\u0430\u0448\u0438 \u0443\u0441\u044B?"
        OutputState: Enemies
        character: {fileID: 1662126093}
      - AnswerContent: "\u042F \u043D\u0430\u0447\u043D\u0443 \u0440\u0430\u0441\u0441\u043B\u0435\u0434\u043E\u0432\u0430\u043D\u0438\u0435,
          \u0441\u044D\u0440."
        OutputState: End
        character: {fileID: 1662126093}
